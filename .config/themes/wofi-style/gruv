* {
  border-radius: 0px;
}

#window {
  margin: 0px;
  border: 2px solid #282828;
  background-color: rgba(40, 40, 40, 0.99999);
  border-radius: 16px;
}

#input {
  margin: 5px;
  border: none;
  color: #ebdbb2;
  background-color: #282828;
  border-radius: 30px;
  box-shadow: none;
}

#inner-box {
  margin: 5px;
  border-radius: 30px;
  background-color: #282828;
}

#outer-box {
  margin: 15px;
  border-radius: 12px;
  background-color: transparent;
}

#scroll {
  margin: 0px;
  border: none;
}

#text {
  margin: 5px;
  border: none;
  color: #ebdbb2;
}

#entry:selected {
  background-color: #282828;
  border-radius: 20px;
  outline: none;
}

#entry:selected * {
  background-color: #32302f;
  border-radius: 20px;
  outline: none;
}
