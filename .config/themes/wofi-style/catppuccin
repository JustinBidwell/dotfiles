* {
  border-radius: 0px;
}

#window {
  margin: 0px;
  border: 2px solid #1e1e2e;
  background-color: rgba(30, 30, 46, 0.99999);
  border-radius: 16px;
}

#input {
  margin: 5px;
  border: none;
  color: #cba6f7;
  background-color: #1e1e2e;
  border-radius: 30px;
  box-shadow: none;
}

#inner-box {
  margin: 5px;
  border-radius: 30px;
  background-color: #1e1e2e;
}

#outer-box {
  margin: 15px;
  border-radius: 12px;
  background-color: transparent;
}

#scroll {
  margin: 0px;
  border: none;
}

#text {
  margin: 5px;
  border: none;
  color: #cba6f7;
}

#entry:selected {
  background-color: #44475a;
  border-radius: 20px;
  outline: none;
}

#entry:selected * {
  background-color: #44475a;
  border-radius: 20px;
  outline: none;
}
