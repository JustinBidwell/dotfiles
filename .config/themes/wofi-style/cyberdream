* {
  border-radius: 0px;
}

#window {
  margin: 0px;
  border: 2px solid #16181a;
  background-color: rgba(22, 24, 26, 0.99999);
  border-radius: 16px;
}

#input {
  margin: 5px;
  border: none;
  color: #bd5eff;
  background-color: #16181a;
  border-radius: 30px;
  box-shadow: none;
}

#inner-box {
  margin: 5px;
  border-radius: 30px;
  background-color: #16181a;
}

#outer-box {
  margin: 15px;
  border-radius: 12px;
  background-color: transparent;
}

#scroll {
  margin: 0px;
  border: none;
}

#text {
  margin: 5px;
  border: none;
  color: #bd5eff;
}

#entry:selected {
  background-color: #3c4048;
  border-radius: 20px;
  outline: none;
}

#entry:selected * {
  background-color: #3c4048;
  border-radius: 20px;
  outline: none;
}
