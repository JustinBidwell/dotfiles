* {
  border: none;
  border-radius: 0;
  font-family: "JetBrainsMono Nerd Font";
  font-weight: bold;
  font-size: 12.5px;
  min-height: 0;
}

window#waybar {
  background: rgba(40, 40, 40, 0.99);
  color: #cdd6f4;
  border-radius: 10px;
  border: 2px #fbf1c7 solid;
}

#workspaces button {
  background-color: #fbf1c7;
  border: none;
  border-radius: 7px;
  padding: 4px;
  margin: 3px;
  transition: all 0.2s ease-in-out;
}

#workspaces button.active {
  color: #282828;
}

#workspaces button.focused {
  color: #282828;
  background: #fbf1c7;
  border-radius: 7px;
}

#workspaces button.urgent {
  color: #282828;
  border-radius: 7px;
}

#workspaces button:hover {
  background-color: transparent;
  color: #cdd6f4;
  border-radius: 7px;
}

#custom-power_profile,
#window,
#clock,
#battery,
#pulseaudio,
#network,
#workspaces,
#placeholder {
  opacity: 0.8;
  padding: 0px 10px;
  margin: 3px 0px;
  margin-top: 5px;
  margin-bottom: 5px;
}

#custom-launch_fuzzel {
  margin-left: 10px;
  color: #fbf1c7;
}

#custom-launch_wlogout {
  color: #fbf1c7;
}

#workspaces {
  border-radius: 15px;
  margin-left: 5px;
  padding-right: 0px;
  padding-left: 5px;
}

#window {
  border-radius: 15px;
  margin-left: 40px;
  margin-right: 40px;
}

#clock {
  color: #fbf1c7;
  border-radius: 15px;
  margin-right: 8px;
  border-right: 0px;
}

#network {
  color: #fbf1c7;
  border-left: 0px;
  border-right: 0px;
  margin-right: 0px;
}

#pulseaudio {
  color: #fbf1c7;
  border-left: 0px;
  border-right: 0px;
  border-radius: 15px 0px 0px 15px;
}

#pulseaudio.microphone {
  color: #fbf1c7;
  border-left: 0px;
  border-right: 0px;
  border-radius: 0px 15px 15px 0px;
  margin-right: 10px;
}

#battery {
  color: #fbf1c7;
  margin-right: 5px;
}
